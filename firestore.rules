rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 계정 이메일 ↔ 부서 (Authentication 사용자와 config.js의 CBCS_ACCOUNTS와 같아야 함)
    function email() { return request.auth != null ? request.auth.token.email : ''; }
    // 교육부 계정 5개(영유치·초등·중고등·청년·교육위원회)만 "로그인한 사람"으로 본다.
    // 다른 계정이 어떻게든 만들어져 로그인해도 아무것도 읽지 못한다(새 가입 차단과 이중 잠금).
    function signedIn() { return request.auth != null && email() in ['kid@cbcs.app', 'youth@cbcs.app', 'teen@cbcs.app', 'flame@cbcs.app', 'minist@cbcs.app']; }
    function isCommittee() { return email() == 'minist@cbcs.app'; }
    function deptEmail(d) {
      return d == 'kinder' ? 'kid@cbcs.app'
           : d == 'elem'   ? 'youth@cbcs.app'
           : d == 'youth'  ? 'teen@cbcs.app'
           : d == 'young'  ? 'flame@cbcs.app'
           : '';
    }
    function isDept(d) { return signedIn() && email() == deptEmail(d); }

    // 부서 자료: 그 부서 계정과 교육위원회(minist)만 읽고 씀
    match /depts/{d} { allow read, write: if isDept(d) || isCommittee(); }
    // 심방 카드(care)는 부서 관리자 비밀번호로 암호화되어 저장됨 — 그 부서 계정만 접근 (교육위원회도 읽지 못함)
    match /depts/{d}/care/{docId} { allow read, write: if isDept(d); }
    match /depts/{d}/{sub}/{docId} { allow read, write: if sub != 'care' && (isDept(d) || isCommittee()); }

    // 교육위원회 공지·공통 일정: 로그인한 모두 읽기, 교육위원회만 쓰기
    match /committee/{docId} { allow read: if signedIn(); allow write: if isCommittee(); }
    match /committee/{docId}/{sub}/{subId} { allow read: if signedIn(); allow write: if isCommittee(); }

    // 진급 예정자 공유 목록: 로그인한 부서 모두 읽고 씀 (보내는 부서가 적고, 받는 부서가 명단에 받음)
    match /promotions/{docId} { allow read, write: if signedIn(); }

    // 차량 신청: 로그인한 부서 모두 읽고 씀 (같은 차량·시간이 겹치는지 서로 봐야 함)
    match /vehicles/{docId} { allow read, write: if signedIn(); }

    // 형제자매 색인(이름·반·형제 이름만, 연락처 없음): 로그인한 모두 읽기, 자기 부서 문서만 쓰기
    match /siblings/{d} { allow read: if signedIn(); allow write: if isDept(d) || isCommittee(); }

    // 장학: 교육위원회 전용
    match /scholarship/{docId} { allow read, write: if isCommittee(); }

    // 보관 색인·가져오기 기록: 로그인한 모두 읽기, 교육위원회만 쓰기
    match /archive/{docId} { allow read: if signedIn(); allow write: if isCommittee(); }
    match /meta/{docId} { allow read: if signedIn(); allow write: if isCommittee(); }
  }
}
